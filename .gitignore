# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore SSH private keys
*.pem

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore lock files and macOS metadata
**/.terraform.lock.hcl
.DS_Store
